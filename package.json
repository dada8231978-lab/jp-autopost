{
  "name": "jp-autopost",
  "version": "1.0.0",
  "private": true,
  "description": "Auto-generate English articles about Japanese culture & healthcare with Claude, and publish them to Buttondown behind a paywall.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "post": "tsx src/index.ts",
    "dry-run": "tsx src/index.ts --dry-run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "tsx src/verify.ts",
    "reddit": "tsx src/reddit-post.ts",
    "seo": "tsx src/seo.ts",
    "status": "tsx src/status.ts",
    "publish": "tsx src/publish.ts",
    "dashboard": "tsx src/dashboard.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
