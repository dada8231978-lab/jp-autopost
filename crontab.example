# Daily Ghost auto-post (Linux / macOS)
#
# Install with:  crontab -e
# Then paste the line below, adjusting the absolute path.
#
# cron runs with a minimal PATH, so give node an explicit one.
PATH=/usr/local/bin:/usr/bin:/bin

# 07:00 every day, server local time.
0 7 * * * /absolute/path/to/記事投稿/scripts/run.sh

# Weekdays only, alternating beats:
# 0 7 * * 1,3,5 /absolute/path/to/記事投稿/scripts/run.sh --category culture
# 0 7 * * 2,4   /absolute/path/to/記事投稿/scripts/run.sh --category healthcare
