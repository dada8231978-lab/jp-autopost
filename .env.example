# ============================================================
#  Anthropic (article generation)
# ============================================================
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for generation.
#   claude-sonnet-5   -> good quality / low cost (default, ~$0.05 per article)
#   claude-opus-5     -> highest quality, ~2.5x the cost
# NOTE: "claude-3-5-sonnet-*" is a retired legacy ID. Do not use it.
ANTHROPIC_MODEL=claude-sonnet-5

# Reasoning effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Max output tokens for one article (non-streaming request).
ANTHROPIC_MAX_TOKENS=16000

# ============================================================
#  Buttondown (publishing)
# ============================================================
# Buttondown -> Settings -> Programming -> API key
BUTTONDOWN_API_KEY=

# Rarely needs changing.
BUTTONDOWN_API_BASE=https://api.buttondown.com/v1

# What to do with a generated article:
#   draft         -> saved for your review, nothing is sent  (SAFE DEFAULT)
#   about_to_send -> queued and sent to subscribers immediately
# Start on draft. Switch to about_to_send once you trust the output.
BUTTONDOWN_EMAIL_STATUS=draft

# Audience. Paywalled emails must go to "public": everyone receives the email,
# and the paywall decides how much of it each reader can see.
BUTTONDOWN_EMAIL_TYPE=public

# Body format: auto | fancy (force HTML) | plaintext (force Markdown)
BUTTONDOWN_EDITOR_MODE=auto

# ============================================================
#  Monetization (display only)
# ============================================================
# The actual price is set in Buttondown -> Settings -> Paid subscriptions.
# This value is used only to print the economics in `npm run verify`.
# 500 = $5.00/month
SUBSCRIPTION_PRICE_CENTS=500
SUBSCRIPTION_CURRENCY=usd

# ============================================================
#  Topic control
# ============================================================
# culture | healthcare | mixed
TOPIC_CATEGORY=mixed

# Target word count for the full article.
TARGET_WORD_COUNT=1600

# ============================================================
#  Reddit (optional — only for `npm run reddit`)
# ============================================================
# Create a "script" app at https://www.reddit.com/prefs/apps
# The client ID is the string shown under the app name.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Reddit requires a unique, descriptive User-Agent or it returns 429/403.
# Leave blank to auto-generate: nodejs:jp-autopost:1.0.0 (by /u/<username>)
REDDIT_USER_AGENT=

# Rotation. The tool posts to whichever eligible subreddit has gone longest
# without a post. Override for one run with `npm run reddit -- --sub <name>`.
#
# Chosen for AUDIENCE FIT, not just rule tolerance:
#   foodforthought - exists to share long-form articles; links are welcome
#   TrueReddit     - same, higher bar; requires a submission-statement comment
#   japan          - largest audience interested in Japan; strictest on self-promo
#
# NOT included on purpose:
#   japanlife      - residents of Japan only. They do not need Japan explained
#                    to them in English and will not subscribe. Good for
#                    feedback, useless for conversion.
REDDIT_SUBREDDITS=foodforthought,TrueReddit,japan

# Minimum days between posts to the SAME subreddit. Frequency is what gets
# accounts and domains banned. Do not lower this without a reason.
REDDIT_MIN_DAYS_BETWEEN=14

# Append a single, clearly-disclosed link to the end of the post.
# Set to false until your account has real karma and posting history.
REDDIT_INCLUDE_LINK=false
REDDIT_LINK_URL=

# Some subreddits reject unflaired posts.
# Run `npm run reddit -- --flairs <subreddit>` to list valid IDs.
REDDIT_FLAIR_ID=
REDDIT_FLAIR_TEXT=

# ============================================================
#  SEO
# ============================================================
# Crawlable internal links to earlier articles, embedded ABOVE the paywall.
# Search engines read the page as anonymous visitors, so links placed below
# the paywall are invisible to them and pass no authority.
# 0 disables. More than ~5 reads as a link farm.
SEO_RELATED_LINKS=3

# With TOPIC_CATEGORY=mixed, the share of articles that should be healthcare,
# measured over the last 10 posts. 0.7 = roughly 7 in 10.
# Set TOPIC_CATEGORY=healthcare instead if you want 100% medical.
HEALTHCARE_RATIO=0.7
